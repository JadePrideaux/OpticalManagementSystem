<Window x:Class="OpticalManagementSystemDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optical App - Create Patient" Height="400" Width="400">

    <StackPanel Margin="20">
        <Label Content="First Name" />
        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <Label Content="Last Name" />
        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <Label Content="Date of Birth" />
        <DatePicker SelectedDate="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <Label Content="Phone Number" />
        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <Button Content="Create Patient" Command="{Binding CreatePatientCommand}" />

        <TextBlock Text="{Binding StatusMessage}" Margin="10,10,0,0" />
    </StackPanel>

</Window>


