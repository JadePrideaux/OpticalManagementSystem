<UserControl x:Class="OpticalManagementSystemDesktop.Views.AddOptomView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="400" Width="400">

    <StackPanel Margin="20">
        <Label Content="First Name" />
        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <Label Content="Last Name" />
        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <Button Content="Create Optometrist" Command="{Binding CreateOptomCommand}" Margin="0,10,0,0"/>

        <Button Content="Back to Main Menu" Command="{Binding BackToMenuCommand}" Margin="0,10,0,0"/>

        <TextBlock Text="{Binding StatusMessage}" Margin="10,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>

</UserControl>
